# =============================================================================
# MaltaStart Backend – örnek ortam değişkenleri
# Kullanım: cp .env.example .env  → değerleri düzenleyin → npm run seed && npm run dev
# =============================================================================

# --- Sunucu ---
PORT=3000
NODE_ENV=development

# --- Veritabanı (zorunlu) ---
MONGODB_URI=mongodb://localhost:27017/maltstart

# --- JWT (zorunlu – production'da güçlü rastgele secret) ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# --- CORS (admin + mobil web/expo – virgülle ayırın) ---
# Vite admin: http://localhost:5173
# Expo web:   http://localhost:8081
# Fiziksel cihaz testinde bilgisayar IP'nizi ekleyin: http://192.168.1.x:8081
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# --- Seed admin kullanıcısı (yalnızca npm run seed) ---
ADMIN_EMAIL=admin@maltstart.com
ADMIN_PASSWORD=Admin123!

# --- Hava durumu (Keşfet ekranı – opsiyonel) ---
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Yüklenen dosyaların public URL öneki ---
# upload API yanıtlarında dönen tam URL için (ör. http://localhost:3000)
PUBLIC_URL=http://localhost:3000

# --- E-posta doğrulama / şifre sıfırlama linkleri ---
# Mobil deep link veya web: verify-email?token=... reset-password?token=...
# Expo Go: http://localhost:8081  |  Production: https://app.maltstart.com
PUBLIC_APP_URL=http://localhost:8081

# --- Gmail (e-posta doğrulama / şifre sıfırlama) ---
# Google Hesap → Güvenlik → 2 adımlı doğrulama → Uygulama şifresi (16 karakter)
# Normal Gmail şifresi ÇALIŞMAZ. Boşluklar otomatik kaldırılır.
# Geliştirmede mail atlamak için: EMAIL_ENABLED=false (linkler API yanıtında devVerifyLink)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_ENABLED=true

# Alternatif SMTP (Gmail yerine):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=MaltaStart <noreply@example.com>
