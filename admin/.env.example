# =============================================================================
# MaltaStart Admin Panel (frontend) – örnek ortam değişkenleri
# Kullanım: cp .env.example .env  → npm run dev  → http://localhost:5173
# Vite yalnızca VITE_ ile başlayan değişkenleri istemciye aktarır.
# =============================================================================

# --- REST API (zorunlu) ---
# Backend çalışıyor olmalı: cd ../backend && npm run dev
VITE_API_URL=http://localhost:3000/api

# --- Socket.io (özel tur canlı sohbet – önerilir) ---
# Genelde API kökü ile aynı host, /api olmadan
VITE_SOCKET_URL=http://localhost:3000

# --- Fiziksel ağ / uzak backend ---
# Bilgisayarınızın LAN IP'si (ör. 192.168.1.42):
# VITE_API_URL=http://192.168.1.42:3000/api
# VITE_SOCKET_URL=http://192.168.1.42:3000
